filetype = "GeoJSON", overwrite = TRUE)
nuts3_ll <- sf::st_as_sf(nuts3_se) |> sf::st_transform(4326)
sf::st_write(nuts3_ll, "data/Sweden_regional_nuts3.geojson", delete_dsn = TRUE)
