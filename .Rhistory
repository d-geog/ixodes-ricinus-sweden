terra::plot(nuts3_se)
terra::writeVector(nuts3_se, "data/Sweden_regional_nuts3.geojson",
filetype = "GeoJSON", overwrite = TRUE)
nuts3_se <- nuts_all[nuts_all$CNTR_CODE == "SE" & nuts_all$LEVL_CODE == 3, ]
